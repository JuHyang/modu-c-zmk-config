#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        reset {
            bindings = <&sys_reset>;
            key-positions = <48 5 6>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------
            // |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |DEL |
            // |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  |HOME|
            // |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |PGUP|
            // |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |PGDN|
            // |LCTL|LALT|LGUI|                                 |RALT|RCTL|END |
            //                |LANG|SPC |MO1 |   |BSPC|RET |MO1 | B  |

            bindings = <
&kp ESC           &kp N1    &kp N2        &kp N3  &kp N4  &kp N5  &kp N6     &kp N7   &kp N8     &kp N9     &kp N0     &kp BACKSPACE
&kp TAB           &kp Q     &kp W         &kp E   &kp R   &kp T   &kp Y      &kp U    &kp I      &kp O      &kp P      &kp LEFT_BRACKET
&kp LEFT_CONTROL  &kp A     &kp S         &kp D   &kp F   &kp G   &kp H      &kp J    &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT         &kp Z     &kp X         &kp C   &kp V   &kp B   &kp N      &kp M    &kp COMMA  &kp DOT    &kp FSLH   &kp RIGHT_SHIFT
&kp LEFT_SHIFT    &kp LALT  &kp EQUAL     &none   &none   &none   &none      &none    &none      &kp MINUS  &kp RCTRL  &kp RIGHT_SHIFT
&kp LEFT_COMMAND  &mo 1     &kp LEFT_ALT                          &kp SPACE  &kp RET  &mo 2      &kp MINUS
            >;
        };

        lower_layer {
            bindings = <
&kp GRAVE   &trans        &trans        &trans        &trans  &trans  &trans  &trans          &trans          &trans            &trans             &kp DEL
&trans      &trans        &trans        &trans        &trans  &trans  &trans  &kp KP_N7       &kp UP_ARROW    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSPC
&trans      &kp LEFT_ALT  &trans        &trans        &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &trans             &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans          &trans          &trans            &trans             &trans
&trans      &trans        &trans        &trans        &trans  &trans  &trans  &trans          &trans          &kp LC(LA(LEFT))  &kp LA(LC(RIGHT))  &kp LA(RETURN)
&trans      &trans        &trans                                      &trans  &trans          &trans          &trans
            >;
        };

        layer_2 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans                          &trans  &trans  &trans  &trans
            >;
        };
    };
};
